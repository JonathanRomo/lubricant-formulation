# Entornos virtuales
.venv/
venv/
env/

# Python: cachés, bytecode y herramientas de pruebas
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/

# Configuración local y secretos
.env
.env.*
!.env.example
/configuracion_interfaz.json

# Editores y sistema operativo
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
~$*

# Compilaciones y entregables generados
/build/
/dist/
*.exe
*.msi
*.zip

# Datos operativos y documentos internos
/CODIGOS_200.xlsx
/ESPECIFICACIONES_JSON/
/ESPECIFICACIONES_JSON_ALINEADAS/
/ESPECIFICACIONES_VIEJAS/
/ESPECIFICACIONES_VIEJAS_ENG/
/HISTORICO_ESPECIFICACIONES/
/METODOS_LAB/
/FORMATOS/
/RESPALDOS_BASE_DATOS/
/REVISAR/

# Bases de datos locales y archivos auxiliares de SQLite
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.recuperacion.lock

# Cachés, reportes y temporales de ejecución
.cache_alineacion
.cache_catalogo_hii
REPORTE_ALINEACION.txt
/REPORTE_RECONSTRUCCION_BASE.json
/tests/REPORTE_RECUPERACION_20_JSON.json
*.tmp
*.temp
*.log

# Directorio de logs: conservar solo el marcador de la estructura
/logs/*
!/logs/.gitkeep
